Notebook[{

Cell[CellGroupData[{
Cell["TG Labs / 50MM - HOCl QA & R&D Suite", "Title",
 FontFamily->"Arial",
 FontColor->RGBColor[
  0.12, 0.35, 0.55],ExpressionUUID->"c3136dc5-5e80-488a-a36d-5c7015a926b6"],

Cell["\<\
Click anywhere in the code cell below and press Shift+Enter (or: Evaluation > \
Evaluate Initialization Cells). Enable Dynamics if Mathematica asks. Requires \
the full repo folder (src/ next to this .nb).\
\>", "Text",
 FontFamily->"Arial",ExpressionUUID->"cd16695a-dad8-4cc4-80aa-2937fb5f0140"],

Cell[BoxData[
 RowBox[{"Unevaluated", "[", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rootDir", ",", "src", ",", "res", ",", "errs"}], "}"}], ",", 
    RowBox[{
     RowBox[{"rootDir", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", "\<\"\"\>"}], "]"}], 
       "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"StringQ", "[", "rootDir", "]"}]}], "||", 
        RowBox[{"rootDir", "===", "\<\"\"\>"}]}], ",", 
       RowBox[{"rootDir", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"DirectoryName", "[", 
            RowBox[{"NotebookFileName", "[", "]"}], "]"}], ",", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}]}], "]"}], ";", 
     RowBox[{"src", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"rootDir", ",", "\<\"src\"\>"}], "}"}], "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"DirectoryQ", "[", "src", "]"}]}], ",", 
       RowBox[{"Return", "[", 
        FrameBox[
         StyleBox[
          
          RowBox[{"\<\"Cannot find src/ next to this notebook.\\nExpected: \"\
\>", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"src", ",", "InputForm"}], "]"}], 
           "<>", "\<\"\\nClone/open the full HOCl-QA-Notebook folder, not a \
lone .nb file.\"\>"}],
          StripOnInput->False,
          ShowStringCharacters->False,
          FontFamily->"Arial",
          FontSize->13,
          FontColor->RGBColor[1, 0, 0]],
         Background->RGBColor[1, 0.93, 0.93],
         FrameMargins->16,
         StripOnInput->False], "]"}]}], "]"}], ";", 
     RowBox[{"$Path", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Prepend", "[", 
        RowBox[{"$Path", ",", "src"}], "]"}], "]"}]}], ";", 
     RowBox[{"errs", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Get", "[", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"src", ",", "f"}], "}"}], "]"}], "]"}], ";", "True"}],
             ",", "False"}], "]"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", "res", "]"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"errs", ",", "f"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", 
         RowBox[{"{", 
          
          RowBox[{"\<\"HOClCore.wl\"\>", ",", "\<\"Electrolysis.wl\"\>", 
           ",", "\<\"Pretreatment.wl\"\>", ",", "\<\"ShelfLife.wl\"\>", 
           ",", "\<\"Byproducts.wl\"\>", ",", "\<\"Formulations.wl\"\>", 
           ",", "\<\"UIComponents.wl\"\>", ",", "\<\"HOClNotebookUI.wl\"\>"}],
           "}"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"$HOClLoadErrors", "=", "errs"}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"errs", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"Return", "[", 
        FrameBox[
         StyleBox[
          RowBox[{"\<\"Package load failed: \"\>", "<>", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"errs", ",", "\<\", \"\>"}], "]"}], 
           "<>", "\<\"\\nPath used: \"\>", "<>", "src"}],
          StripOnInput->False,
          ShowStringCharacters->False,
          FontFamily->"Arial",
          FontSize->13,
          FontColor->RGBColor[1, 0, 0]],
         Background->RGBColor[1, 0.93, 0.93],
         FrameMargins->16,
         StripOnInput->False], "]"}]}], "]"}], ";", 
     RowBox[{"Quiet", "[", 
      RowBox[{"HOClNotebookUI`HOClLoadAll", "[", "rootDir", "]"}], "]"}], ";", 
     StyleBox[
      RowBox[{"HOClNotebookUI`HOClDashboard", "[", "]"}],
      StripOnInput->False,
      FormatType->StandardForm,
      ShowStringCharacters->False]}]}], "]"}], "]"}]], "Input",

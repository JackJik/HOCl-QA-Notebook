Notebook[{
Cell["TG Labs / 50MM \[AHat]\.80\.94 HOCl QA & R&D Suite", "Title",ExpressionUUID->"1d51e374-e031-426a-b8bc-2fe6fae8b8af"],

Cell["\<\
Self-contained HOCl QA Bench + R&D Engine. If the dashboard does not appear, \
choose Evaluation \[AHat]\.86\.92 Evaluate Initialization Cells, and click \
Enable Dynamics if prompted. Requires full Mathematica on macOS. No \
internet/paclets.\
\>", "Text",ExpressionUUID->"549ace9c-1897-4647-9779-e1dd2874253a"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"root", ",", " ", "src", ",", " ", "res"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"root", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<\>\""}], 
         "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"StringQ", "[", "root", "]"}]}], " ", "||", " ", 
         RowBox[{"root", " ", "===", " ", "\"\<\>\""}]}], ",", "\n", "    ", 
        RowBox[{"root", " ", "=", " ", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"DirectoryName", "[", 
             RowBox[{"NotebookFileName", "[", "]"}], "]"}], ",", " ", 
            RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}]}], "\n", "  ", 
       "]"}], ";", "\n", "  ", 
      RowBox[{"src", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", " ", "\"\<src\>\""}], "}"}], "]"}]}], ";", "\n",
       "  ", 
      RowBox[{"$Path", " ", "=", " ", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Prepend", "[", 
         RowBox[{"$Path", ",", " ", "src"}], "]"}], "]"}]}], ";", "\n", "  ", 
      
      RowBox[{"$HOClLoadErrors", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"res", " ", "=", " ", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Get", "[", 
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"src", ",", " ", "f"}], "}"}], "]"}], "]"}], ";", 
              " ", "True"}], ",", " ", "False"}], "]"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", "res", "]"}]}], ",", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"$HOClLoadErrors", ",", " ", "f"}], "]"}]}], "]"}]}], ",",
         "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"f", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<HOClCore.wl\>\"", ",", " ", "\"\<Electrolysis.wl\>\"",
             ",", " ", "\"\<Pretreatment.wl\>\"", ",", "\n", 
            "      ", "\"\<ShelfLife.wl\>\"", ",", 
            " ", "\"\<Byproducts.wl\>\"", ",", " ", "\"\<Formulations.wl\>\"",
             ",", "\n", "      ", "\"\<UIComponents.wl\>\"", ",", 
            " ", "\"\<HOClNotebookUI.wl\>\""}], "}"}]}], "}"}]}], "\n", "  ", 
       "]"}], ";", "\n", "  ", 
      RowBox[{"HOClNotebookUI`HOClLoadAll", "[", "root", "]"}], ";", "\n", 
      "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "$HOClLoadErrors", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "$HOClLoadErrors", "]"}], " ", ">", " ", 
          "0"}]}], ",", "\n", "    ", 
        RowBox[{"Framed", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<Package load problem: \>\"", " ", "<>", " ", 

Notebook[{

Cell[CellGroupData[{
Cell["TG Labs / 50MM - HOCl QA & R&D Suite", "Title",
 FontFamily->"Arial",
 FontColor->RGBColor[
  0.12, 0.35, 0.55],ExpressionUUID->"47b1f9dc-7dfc-4e5f-abe1-bb2c25450c75"],

Cell["\<\
Self-contained HOCl QA Bench + R&D Engine. If the dashboard does not appear: \
Evaluation > Evaluate Initialization Cells, and enable dynamics if prompted. \
Full Mathematica on macOS. No internet or paclets.\
\>", "Text",
 FontFamily->"Arial",ExpressionUUID->"9ff85067-49ac-491b-90a8-8561a1381a65"],

Cell[BoxData[
 RowBox[{"Unevaluated", "[", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"root", ",", "src", ",", "res", ",", "dash"}], "}"}], ",", 
    RowBox[{
     RowBox[{"root", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", "\<\"\"\>"}], "]"}], 
       "]"}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"StringQ", "[", "root", "]"}]}], "||", 
        RowBox[{"root", "===", "\<\"\"\>"}]}], ",", 
       RowBox[{"root", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"DirectoryName", "[", 
            RowBox[{"NotebookFileName", "[", "]"}], "]"}], ",", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}]}], "]"}], ";", 
     RowBox[{"src", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"root", ",", "\<\"src\"\>"}], "}"}], "]"}]}], ";", 
     RowBox[{"$Path", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Prepend", "[", 
        RowBox[{"$Path", ",", "src"}], "]"}], "]"}]}], ";", 
     RowBox[{"$HOClLoadErrors", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Get", "[", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"src", ",", "f"}], "}"}], "]"}], "]"}], ";", "True"}],
             ",", "False"}], "]"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", "res", "]"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"$HOClLoadErrors", ",", "f"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", 
         RowBox[{"{", 
          
          RowBox[{"\<\"HOClCore.wl\"\>", ",", "\<\"Electrolysis.wl\"\>", 
           ",", "\<\"Pretreatment.wl\"\>", ",", "\<\"ShelfLife.wl\"\>", 
           ",", "\<\"Byproducts.wl\"\>", ",", "\<\"Formulations.wl\"\>", 
           ",", "\<\"UIComponents.wl\"\>", ",", "\<\"HOClNotebookUI.wl\"\>"}],
           "}"}]}], "}"}]}], "]"}], ";", 
     RowBox[{"Quiet", "[", 
      RowBox[{"HOClNotebookUI`HOClLoadAll", "[", "root", "]"}], "]"}], ";", 
     RowBox[{"dash", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "$HOClLoadErrors", "]"}], "&&", 
         RowBox[{
          RowBox[{"Length", "[", "$HOClLoadErrors", "]"}], ">", "0"}]}], ",", 
        
        FrameBox[
         StyleBox[
          RowBox[{"\<\"Package load problem: \"\>", "<>", 
           RowBox[{"StringRiffle", "[", 
            RowBox[{"$HOClLoadErrors", ",", "\<\", \"\>"}], "]"}], 
           "<>", "\<\". Ensure the src/ folder sits next to this \
notebook.\"\>"}],
          StripOnInput->False,
          ShowStringCharacters->False,
          FontFamily->"Arial",
          FontSize->13,
          FontColor->RGBColor[1, 0, 0]],
         Background->RGBColor[1, 0.93, 0.93],
         FrameMargins->12,
         StripOnInput->False], ",", 
        RowBox[{"HOClNotebookUI`HOClDashboard", "[", "]"}]}], "]"}]}], ";", 
     StyleBox["dash",
      StripOnInput->False,
      FormatType->StandardForm,
      ShowStringCharacters->False]}]}], "]"}], "]"}]], "Input",
 CellOpen->False,
 InitializationCell->True,
 FontSize->10,ExpressionUUID->"d9e63e56-efa6-41e4-a228-94bd127b6417"],

